# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/cleandog?schema=public"

# ── Auth (NextAuth v5) ────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Admin seed (used by prisma/seed.ts) ───────────────────────
ADMIN_EMAIL="admin@cleandog.local"
ADMIN_PASSWORD="change-me-strong"

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Cleandog <noreply@cleandog.local>"

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TZ="Europe/Rome"

# ── Web Push (VAPID) ──────────────────────────────────────────
# Generate via: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cleandog.local"

# ── Cron protection ───────────────────────────────────────────
# Random secret to authenticate /api/cron/reminders
CRON_SECRET=""
